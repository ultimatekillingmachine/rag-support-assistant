# ------------------------------------------------------------------
# Storage: sqlite (local dev, zero setup) | postgres (prod, pgvector)
# ------------------------------------------------------------------
STORAGE_BACKEND=sqlite
SQLITE_PATH=data/app.db
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag

# ------------------------------------------------------------------
# Knowledge base
# ------------------------------------------------------------------
KB_DIR=knowledge_base

# ------------------------------------------------------------------
# Embeddings (fastembed / ONNX, runs locally, no API keys)
# Options verified with fastembed:
#   intfloat/multilingual-e5-large              (1024d, best quality, ~1.1 GB)
#   sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (384d, light)
#   minishlab/potion-multilingual-128M          (256d, fastest)
# ------------------------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# ------------------------------------------------------------------
# LLM: mock | openai_compatible | ollama
#   mock              - extractive answer from retrieved context (tests/CI/demo without keys)
#   openai_compatible - DeepSeek, OpenAI, OpenRouter and others (one API format)
#   ollama            - local models, free and offline (http://localhost:11434/v1)
#
# The API key is a paid credential of the provider, NOT a Cline/IDE setting:
# the application reads it from this file only.
#
# DeepSeek example (prices: https://api-docs.deepseek.com/quick_start/pricing)
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_API_KEY=sk-...                 <- from platform.deepseek.com/api_keys
#   LLM_MODEL=deepseek-flash           <- current names: deepseek-flash | deepseek-v4-pro
#   LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}   <- optional: skips the
#     default reasoning mode, so support answers come back several times faster
#
# Local Ollama example (no key, no cost)
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:7b
# ------------------------------------------------------------------
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
LLM_EXTRA_BODY={}

# ------------------------------------------------------------------
# Retrieval / chunking
# ------------------------------------------------------------------
TOP_K=5
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=150

# ------------------------------------------------------------------
# Retrieval. HYBRID_ENABLED adds keyword (BM25) search to meaning search and
# fuses the two rankings. Measured on data/eval with stemming enabled: hybrid
# matches the meaning-only baseline on hit@1/hit@3 and is slightly better on
# MRR (0.971 vs 0.967). LEXICAL_STEMMING collapses Russian word forms, which is
# what makes the keyword branch competitive.
# ------------------------------------------------------------------
HYBRID_ENABLED=true
RRF_K=60
CANDIDATE_POOL=20
# RRF weights: the embedding model is the primary signal on this corpus;
# BM25 adds exact-term recall as a secondary signal (tuned on data/eval).
VECTOR_WEIGHT=1.0
LEXICAL_WEIGHT=0.25
LEXICAL_STEMMING=true
# Relevance gate: refuse to answer when even the best match is below this value
# (0 disables). Thresholds are model-specific — pick yours with gate_report.
MIN_RELEVANCE_SCORE=0.80
# Diversity cap: at most N chunks of the same article in the context (0 = off)
MAX_CHUNKS_PER_SLUG=1

# ------------------------------------------------------------------
# Second-stage reranking (Phase 2c). A cross-encoder reads question and
# candidate together for a more accurate order; slower, so it is optional.
# Measure first: python -m scripts.run_eval
# ------------------------------------------------------------------
RERANK_ENABLED=false
RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
RERANK_BATCH_SIZE=32

# ------------------------------------------------------------------
# Access control (Phase 3). The role is resolved from the bearer token and
# decides which articles are searchable:
#   customer token -> only public help articles (audience: customer)
#   operator token -> public + internal articles (audience: operator)
# Change these values in any real deployment; keep AUTH_ENABLED=false only
# for local experiments.
# ------------------------------------------------------------------
AUTH_ENABLED=true
API_TOKEN_CUSTOMER=customer-token
API_TOKEN_OPERATOR=operator-token

# ------------------------------------------------------------------
# Response cache (Phase 3). Repeated questions skip both retrieval and the LLM
# call; the cache key includes the audience, so internal answers are never
# served to customers. Set CACHE_ENABLED=false to measure cold latency.
# ------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=256
CACHE_TTL_SECONDS=900
