# ------------------------------------------------------------------
# Storage: sqlite (local dev, zero setup) | postgres (prod, pgvector)
# ------------------------------------------------------------------
STORAGE_BACKEND=sqlite
SQLITE_PATH=data/app.db
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag

# ------------------------------------------------------------------
# Knowledge base
# ------------------------------------------------------------------
KB_DIR=knowledge_base

# ------------------------------------------------------------------
# Embeddings (fastembed / ONNX, runs locally, no API keys)
# Options verified with fastembed:
#   intfloat/multilingual-e5-large              (1024d, best quality, ~1.1 GB)
#   sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (384d, light)
#   minishlab/potion-multilingual-128M          (256d, fastest)
# ------------------------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# ------------------------------------------------------------------
# LLM: mock | openai_compatible | ollama
#   mock              - extractive answer from retrieved context (tests/CI/demo without keys)
#   openai_compatible - OpenAI, OpenRouter, etc.
#   ollama            - local models via OpenAI-compatible endpoint
# ------------------------------------------------------------------
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------
# Retrieval / chunking
# ------------------------------------------------------------------
TOP_K=5
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=150

# ------------------------------------------------------------------
# Retrieval mode (Phase 2b): hybrid = vector + BM25 fused with RRF.
# Measured on data/eval: weighted hybrid ties vector on hit@1 but trails on
# hit@3 (Russian morphology vs semantics), so the default is vector-only.
# Set to true when exact-term recall matters more than semantic ranking.
# ------------------------------------------------------------------
HYBRID_ENABLED=false
RRF_K=60
CANDIDATE_POOL=20
# Relevance gate: refuse to answer when even the best cosine score is below
# this value (0 disables). Tuned on data/eval — see README for the procedure.
MIN_RELEVANCE_SCORE=0.80
# RRF weights (vector is the primary signal; BM25 adds exact-term recall)
VECTOR_WEIGHT=1.0
LEXICAL_WEIGHT=0.25
# Diversity cap: at most N chunks of the same article in the context (0 = off)
MAX_CHUNKS_PER_SLUG=1
